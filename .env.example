# VTS 默认环境变量示例。复制为 .env 后按需填写：cp .env.example .env
# 全部可选——「字幕优先」路径不需要任何 Key。
# 变量按槽位命名：SUMMARY_* = 推理槽（总结与文本润色），ASR_* = 转写槽。
# 旧名 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL / OPENAI_API_KEY 仍被识别（兼容别名）。

# ============ 推理槽：总结 + 文本润色（BYOK：任意 OpenAI 兼容端点）============
# 不配置也能用：任务仍产出转写原文（.txt/.srt），只是跳过总结阶段
# （处理过程里会标注 summarize_skipped）；补上 Key 后「重新生成」即可。
# SUMMARY_API_KEY=
# SUMMARY_BASE_URL=https://api.deepseek.com/v1
# SUMMARY_MODEL=deepseek-chat

# 自有/第三方端点的示例（取消注释并替换）：
# SUMMARY_BASE_URL=https://api.openai.com/v1
# SUMMARY_MODEL=gpt-4o-mini
# SUMMARY_BASE_URL=http://127.0.0.1:11434/v1

# ============ 转写槽（视频没有自带字幕时才需要）============
# OpenAI 官方，或任意实现 /audio/transcriptions 的兼容端点。
# 用第三方端点时这里填该端点自己的 Key（CLI 等价参数：--asr-key / --asr-base-url / --asr-model）
# ASR_API_KEY=
# ASR_BASE_URL=
# ASR_MODEL=whisper-1
# 转写响应格式：默认先请求 verbose_json（含分段/时间戳，可产出 .srt 字幕）；
# 若端点以 HTTP 400 且错误信息提及 response_format 拒绝，则自动降级 json
# （仅文本，无分段/SRT）并打 WARNING。部分兼容端点只支持 json/text，
# 可固定格式省去每次先失败一次的往返：ASR_RESPONSE_FORMAT=json
# ASR_RESPONSE_FORMAT=

# ============ 总结行为 ============
SUMMARY_TEMPLATE=通用
# 文本优化（LLM 润色转写稿）：默认关闭
# POLISH_TRANSCRIPT=0
# POLISH_MODEL=

# ============ 网络 ============
# 代理：CLI 传 --proxy，或 Web「设置 → 网络与访问」填写（无对应环境变量）
# 自定义 yt-dlp User-Agent：B 站 412 风控等场景按需设置（非空生效；空 = yt-dlp 默认 UA）
# VTS_USER_AGENT=Wget/1.21.3
# 登录 cookies 文件（等价 CLI --cookies；显式文件优先于浏览器 cookies；文件不存在会告警忽略并说明路径）
# VTS_COOKIES_FILE=/data/cookies.txt
# 服务监听地址与端口（scripts/web.sh 读取）
# HOST=127.0.0.1
# PORT=8080

# ============ 服务端 ============
# 可选鉴权：设置后所有 /api/* 需带 Authorization: Bearer <TOKEN> 或 X-Auth-Token。
# 暴露到局域网/公网前必须配置。
# VIDEO_TO_SUMMARY_TOKEN=
# SQLite 库路径（默认 <仓库根>/data/app.db）
# VIDEO_TO_SUMMARY_DB=
# 任务产物根目录（默认 ./output）
# VIDEO_TO_SUMMARY_OUTPUT_DIR=
# 同时运行的任务数上限（默认 2）
# VIDEO_TO_SUMMARY_MAX_CONCURRENT=2
# 单任务超时秒数（0 = 不限制）
# VIDEO_TO_SUMMARY_JOB_TIMEOUT=0

# ============ 测试 ============
# 需要联网的集成用例默认跳过；置 1 后运行
# VTS_NETWORK_TESTS=1
